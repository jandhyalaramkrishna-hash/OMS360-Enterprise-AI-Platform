# OMS-360 Version 1.0 - environment configuration template.
# Copy to .env and fill in real values. .env is gitignored - never commit
# real credentials. Every value here has a fallback default in
# app/config.py for local dev convenience, but production deployments
# should always set these explicitly via .env or real environment
# variables (e.g. Docker secrets), not rely on the code defaults.

# --- Database ---------------------------------------------------------
OMS360_DB_HOST=127.0.0.1
OMS360_DB_PORT=3306
OMS360_DB_USER=root
OMS360_DB_PASSWORD=change_me
OMS360_DB_NAME=oms360_db

# --- Kafka --------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OMS360_KAFKA_ENABLED=true
OMS360_KAFKA_GROUP=oms360-fulfillment-service

# --- Simulation timing (seconds) ----------------------------------------
OMS360_SIM_COOKING_SECONDS=8
OMS360_SIM_DELIVERY_SECONDS=12

# --- Application environment (V1.1) --------------------------------------
OMS360_APP_ENV=development
OMS360_LOG_LEVEL=INFO
OMS360_DEBUG_MODE=false
OMS360_DOCKER_MODE=false
OMS360_BUILD_VERSION=dev-local

# --- Feature flags (V1.1) -------------------------------------------------
OMS360_FEATURE_INVENTORY_LEDGER=true
OMS360_FEATURE_DASHBOARD_ANALYTICS=true
OMS360_FEATURE_NOTIFICATIONS=false

# --- Notifications (placeholders - no provider wired up yet) -------------
OMS360_EMAIL_SMTP_HOST=
OMS360_EMAIL_SMTP_PORT=587
OMS360_EMAIL_FROM=
OMS360_SMS_PROVIDER=
OMS360_SMS_API_KEY=

# --- GPS / future AI (placeholders, V2 roadmap) ---------------------------
OMS360_GPS_PROVIDER=
OMS360_GPS_API_KEY=
OMS360_AI_PROVIDER=
OMS360_AI_MODEL_NAME=
OMS360_AI_API_KEY=
